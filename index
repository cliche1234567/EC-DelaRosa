<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>kloudNine - Shop the Latest Trends</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@700&display=swap');
        
        .hero-bg {
            background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.55)), url('https://picsum.photos/id/1015/2000/1200');
            background-size: cover;
            background-position: center;
        }
        
        .product-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .product-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.15);
        }
    </style>
</head>
<body class="font-sans bg-gray-50">

    <!-- Navbar -->
    <nav class="bg-white border-b sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-gradient-to-br from-sky-500 to-indigo-600 rounded-3xl flex items-center justify-center text-white text-3xl font-bold">☁️</div>
                <span class="text-3xl font-bold tracking-tight">kloudNine</span>
            </div>

            <div class="hidden md:flex items-center gap-8 text-sm font-medium">
                <a href="#" class="hover:text-sky-600 transition-colors">Shop All</a>
                <a href="#categories" class="hover:text-sky-600 transition-colors">Categories</a>
                <a href="#deals" class="hover:text-sky-600 transition-colors">Deals</a>
                <a href="#new" class="hover:text-sky-600 transition-colors">New Arrivals</a>
            </div>

            <div class="flex items-center gap-5">
                <div class="relative hidden md:block w-80">
                    <input type="text" id="search" 
                           class="w-full bg-gray-100 border border-transparent focus:border-sky-300 rounded-full py-3 pl-12 text-sm focus:outline-none"
                           placeholder="Search wireless earbuds, fashion, home decor...">
                    <i class="fa-solid fa-magnifying-glass absolute left-5 top-3.5 text-gray-400"></i>
                </div>
                <button onclick="toggleCart()" class="relative p-3 hover:bg-gray-100 rounded-2xl transition-colors">
                    <i class="fa-solid fa-bag-shopping text-2xl"></i>
                    <span id="cart-count" class="absolute -top-1 -right-1 bg-sky-600 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">0</span>
                </button>
            </div>
        </div>
    </nav>

    <!-- Hero -->
    <section class="hero-bg h-screen flex items-center text-white">
        <div class="max-w-3xl mx-auto text-center px-6">
            <span class="bg-white/20 backdrop-blur-md px-6 py-2 rounded-full text-sm font-medium tracking-wider">🚀 FREE SHIPPING ON ORDERS OVER $50</span>
            <h1 class="text-6xl md:text-7xl font-bold mt-8 leading-none">
                Shop Smarter.<br>Live Better.
            </h1>
            <p class="mt-6 text-2xl text-white/90 max-w-lg mx-auto">
                Premium products from trusted suppliers. Delivered fast with zero hassle.
            </p>
            <div class="mt-10 flex flex-wrap justify-center gap-4">
                <button onclick="document.getElementById('featured').scrollIntoView({behavior:'smooth'})" 
                        class="bg-white text-gray-900 px-10 py-5 rounded-3xl font-semibold text-lg hover:bg-gray-100">
                    Shop Now
                </button>
                <button onclick="document.getElementById('categories').scrollIntoView({behavior:'smooth'})" 
                        class="border-2 border-white px-10 py-5 rounded-3xl font-semibold text-lg hover:bg-white/10">
                    Explore Categories
                </button>
            </div>
        </div>
    </section>

    <!-- Categories -->
    <section id="categories" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-6">
            <h2 class="text-4xl font-bold text-center mb-4">Popular Categories</h2>
            <p class="text-center text-gray-600 mb-12">Handpicked collections updated daily</p>

            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
                <div class="group cursor-pointer">
                    <div class="aspect-square rounded-3xl overflow-hidden bg-gray-100">
                        <img src="https://picsum.photos/id/201/600/600" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                    </div>
                    <p class="text-center font-semibold mt-4">Fashion &amp; Apparel</p>
                </div>
                <div class="group cursor-pointer">
                    <div class="aspect-square rounded-3xl overflow-hidden bg-gray-100">
                        <img src="https://picsum.photos/id/367/600/600" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                    </div>
                    <p class="text-center font-semibold mt-4">Electronics</p>
                </div>
                <div class="group cursor-pointer">
                    <div class="aspect-square rounded-3xl overflow-hidden bg-gray-100">
                        <img src="https://picsum.photos/id/866/600/600" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                    </div>
                    <p class="text-center font-semibold mt-4">Home &amp; Kitchen</p>
                </div>
                <div class="group cursor-pointer">
                    <div class="aspect-square rounded-3xl overflow-hidden bg-gray-100">
                        <img src="https://picsum.photos/id/1015/600/600" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                    </div>
                    <p class="text-center font-semibold mt-4">Beauty &amp; Care</p>
                </div>
                <div class="group cursor-pointer">
                    <div class="aspect-square rounded-3xl overflow-hidden bg-gray-100">
                        <img src="https://picsum.photos/id/669/600/600" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                    </div>
                    <p class="text-center font-semibold mt-4">Sports &amp; Outdoors</p>
                </div>
                <div class="group cursor-pointer">
                    <div class="aspect-square rounded-3xl overflow-hidden bg-gray-100">
                        <img src="https://picsum.photos/id/106/600/600" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                    </div>
                    <p class="text-center font-semibold mt-4">Accessories</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Products -->
    <section id="featured" class="py-20 bg-gray-50">
        <div class="max-w-7xl mx-auto px-6">
            <h2 class="text-4xl font-bold mb-3">Featured Products</h2>
            <p class="text-gray-600 mb-12">Best selling products right now on kloudNine</p>

            <div id="products-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
                <!-- Populated by JavaScript -->
            </div>
        </div>
    </section>

    <!-- Deals -->
    <section id="deals" class="bg-gradient-to-r from-sky-600 via-indigo-600 to-violet-600 py-20 text-white">
        <div class="max-w-7xl mx-auto px-6 text-center">
            <span class="uppercase tracking-widest text-sm font-medium bg-white/20 px-8 py-3 rounded-full">Limited Time Offer</span>
            <h2 class="text-5xl font-bold mt-6 mb-4">Summer Clearance – Up to 70% Off</h2>
            <p class="text-xl max-w-2xl mx-auto">Don't miss out on these trending products while supplies last.</p>
            <button onclick="document.getElementById('featured').scrollIntoView({behavior:'smooth'})" 
                    class="mt-10 bg-white text-sky-600 px-12 py-5 rounded-3xl font-bold text-lg hover:scale-105 transition-transform">
                Grab the Deals →
            </button>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-400 py-16">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid md:grid-cols-5 gap-10">
                <div class="md:col-span-2">
                    <div class="flex items-center gap-3 text-white mb-6">
                        <div class="w-10 h-10 bg-gradient-to-br from-sky-500 to-indigo-600 rounded-3xl flex items-center justify-center text-3xl font-bold">☁️</div>
                        <span class="text-3xl font-bold">kloudNine</span>
                    </div>
                    <p class="max-w-sm">Modern dropshipping store delivering high-quality products directly from suppliers to your door.</p>
                </div>
                <div>
                    <h4 class="text-white mb-5 font-semibold">Quick Links</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="#" class="hover:text-white">Track Your Order</a></li>
                        <li><a href="#" class="hover:text-white">Shipping Policy</a></li>
                        <li><a href="#" class="hover:text-white">Returns &amp; Refunds</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-white mb-5 font-semibold">Shop</h4>
                    <ul class="space-y-2 text-sm">
                        <li><a href="#" class="hover:text-white">New Arrivals</a></li>
                        <li><a href="#" class="hover:text-white">Best Sellers</a></li>
                        <li><a href="#" class="hover:text-white">Clearance</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-white mb-5 font-semibold">Contact</h4>
                    <p class="text-sm">support@kloudnine.store</p>
                    <p class="text-sm mt-1">Mon–Fri 9AM–6PM EST</p>
                </div>
            </div>
            <div class="border-t border-gray-800 mt-16 pt-8 text-xs flex justify-between">
                <p>© 2026 kloudNine. All rights reserved.</p>
                <p>Built as a demo homepage</p>
            </div>
        </div>
    </footer>

    <!-- Cart Sidebar -->
    <div id="cart-sidebar" class="fixed top-0 right-0 w-full md:w-96 h-full bg-white shadow-2xl translate-x-full transition-transform duration-300 z-50 flex flex-col">
        <div class="p-6 border-b flex justify-between items-center">
            <h3 class="text-2xl font-bold">Your Cart</h3>
            <button onclick="toggleCart()" class="text-4xl leading-none text-gray-400 hover:text-gray-600">×</button>
        </div>
        <div id="cart-items" class="flex-1 p-6 overflow-y-auto"></div>
        <div class="p-6 border-t">
            <div class="flex justify-between text-xl font-semibold mb-6">
                <span>Total</span>
                <span id="cart-total">$0.00</span>
            </div>
            <button onclick="checkout()" class="w-full py-5 bg-gradient-to-r from-sky-500 to-indigo-600 text-white font-bold rounded-3xl text-lg">
                Checkout Securely
            </button>
        </div>
    </div>

    <script>
        const products = [
            { id:1, name:"Sony WH-1000XM5 Wireless Headphones", price:89.99, image:"https://picsum.photos/id/201/600/600", category:"Electronics" },
            { id:2, name:"Premium Leather Crossbody Bag", price:64.99, image:"https://picsum.photos/id/367/600/600", category:"Fashion" },
            { id:3, name:"Smart WiFi LED Light Bulbs (4 Pack)", price:34.99, image:"https://picsum.photos/id/866/600/600", category:"Home" },
            { id:4, name:"Stainless Steel Tumbler Set", price:28.50, image:"https://picsum.photos/id/106/600/600", category:"Kitchen" },
            { id:5, name:"Vitamin C + Hyaluronic Acid Serum", price:42.00, image:"https://picsum.photos/id/1015/600/600", category:"Beauty" },
            { id:6, name:"Portable Outdoor Bluetooth Speaker", price:49.99, image:"https://picsum.photos/id/669/600/600", category:"Electronics" }
        ];

        let cart = [];

        function renderProducts() {
            const container = document.getElementById('products-grid');
            container.innerHTML = '';
            
            products.forEach(product => {
                container.innerHTML += `
                    <div class="product-card bg-white rounded-3xl overflow-hidden border">
                        <img src="${product.image}" class="w-full h-64 object-cover">
                        <div class="p-6">
                            <p class="text-xs text-gray-500">${product.category}</p>
                            <h3 class="font-semibold mt-2 leading-tight">${product.name}</h3>
                            <div class="flex justify-between items-center mt-6">
                                <span class="text-2xl font-bold">$${product.price}</span>
                                <button onclick="addToCart(${product.id})" 
                                        class="bg-gray-900 text-white px-6 py-3 rounded-2xl text-sm font-medium hover:bg-black transition-colors">
                                    Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        function addToCart(id) {
            const product = products.find(p => p.id === id);
            const existing = cart.find(item => item.id === id);
            
            if (existing) existing.quantity = (existing.quantity || 1) + 1;
            else cart.push({...product, quantity: 1});
            
            updateCart();
            showToast(`${product.name} added to cart`);
        }

        function updateCart() {
            document.getElementById('cart-count').textContent = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
        }

        function toggleCart() {
            document.getElementById('cart-sidebar').classList.toggle('translate-x-full');
            renderCart();
        }

        function renderCart() {
            const container = document.getElementById('cart-items');
            let html = '';
            let total = 0;

            if (cart.length === 0) {
                html = `<p class="text-center text-gray-400 py-12">Your cart is empty</p>`;
            } else {
                cart.forEach((item, index) => {
                    const itemTotal = item.price * (item.quantity || 1);
                    total += itemTotal;
                    html += `
                        <div class="flex gap-4 mb-8">
                            <img src="${item.image}" class="w-20 h-20 object-cover rounded-2xl">
                            <div class="flex-1">
                                <div class="font-medium">${item.name}</div>
                                <div class="text-sm text-gray-500">Qty: ${item.quantity || 1}</div>
                                <div class="font-semibold mt-2">$${itemTotal.toFixed(2)}</div>
                            </div>
                            <button onclick="removeFromCart(${index})" class="text-red-400">Remove</button>
                        </div>
                    `;
                });
            }
            container.innerHTML = html;
            document.getElementById('cart-total').textContent = `$${total.toFixed(2)}`;
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            renderCart();
            updateCart();
        }

        function checkout() {
            if (cart.length === 0) return alert("Cart is empty!");
            alert("Thank you for shopping at kloudNine! (Demo checkout successful)");
            cart = [];
            updateCart();
            toggleCart();
        }

        function showToast(msg) {
            const toast = document.createElement('div');
            toast.className = "fixed bottom-6 left-1/2 -translate-x-1/2 bg-gray-900 text-white px-8 py-4 rounded-3xl shadow-2xl z-[100]";
            toast.textContent = msg;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 2800);
        }

        // Search
        document.getElementById('search').addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase();
            const filtered = products.filter(p => p.name.toLowerCase().includes(term));
            const container = document.getElementById('products-grid');
            container.innerHTML = '';
            (filtered.length ? filtered : products).forEach(product => {
                container.innerHTML += `
                    <div class="product-card bg-white rounded-3xl overflow-hidden border">
                        <img src="${product.image}" class="w-full h-64 object-cover">
                        <div class="p-6">
                            <p class="text-xs text-gray-500">${product.category}</p>
                            <h3 class="font-semibold mt-2 leading-tight">${product.name}</h3>
                            <div class="flex justify-between items-center mt-6">
                                <span class="text-2xl font-bold">$${product.price}</span>
                                <button onclick="addToCart(${product.id})" class="bg-gray-900 text-white px-6 py-3 rounded-2xl text-sm font-medium hover:bg-black">Add to Cart</button>
                            </div>
                        </div>
                    </div>
                `;
            });
        });

        // Initialize
        window.onload = () => {
            renderProducts();
        };
    </script>
</body>
</html>
